[Unit]
Description=SIoT auro-balancing-necleo Knowledge MCP Server (NUCLEO-F401RE self-balancing robot, v1 JGB37-520 + TB6612FNG)
After=network.target

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/home/mcp/mcp-servers/auro-balancing-knowledge
Environment="PATH=/home/mcp/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="AUROBAL_KNOWLEDGE_ROOT=/home/mcp/knowledge/auro-balancing-necleo"
ExecStart=/home/mcp/.local/bin/uv run python server.py streamable-http 127.0.0.1 8022
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
